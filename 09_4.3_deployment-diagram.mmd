            C1a["Ticketing, Fraud Detection<br/>(Docker containers)"]
            C2a["Journey Planning, Tracking, Notification<br/>(Docker containers)"]
        end
        subgraph "AZ 2"
            C1b["Ticketing, Fraud Detection<br/>(Docker containers)"]
            C2b["Journey Planning, Tracking, Notification<br/>(Docker containers)"]
        end
    end
    GW --> C1a
    GW --> C2a
    GW --> C1b
    GW --> C2b
